version: v2
# Вендоренные контракты (google/api) не генерируем: их Go-типы уже есть
# в google.golang.org/genproto, дубли ломают protoregistry на старте.
inputs:
  - directory: .
    exclude_paths:
      - api/proto/google
plugins:
  - local: protoc-gen-go
    out: gen
    opt:
      - paths=source_relative
  - local: protoc-gen-go-grpc
    out: gen
    opt:
      - paths=source_relative
  - local: protoc-gen-grpc-gateway
    out: gen
    opt:
      - paths=source_relative
  - local: protoc-gen-openapiv2
    out: gen
    # allow_merge склеивает всё в один api.swagger.json, поэтому плагину
    # нужны все файлы разом: со strategy: directory (умолчание) каждый
    # каталог выдал бы свой api.swagger.json, и buf оставил бы только первый.
    strategy: all
    opt:
      - allow_merge=true
      - merge_file_name=api
