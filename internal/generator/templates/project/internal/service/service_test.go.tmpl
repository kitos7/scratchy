package service_test

import (
	"context"
	"testing"

	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/mock"
	"github.com/stretchr/testify/require"

	"[[.Module]]/internal/di/ditest"
)

// Тесты собирают окружение через тестовый wire-контейнер (ditest):
// сервис получает мок репозитория, ожидания ставятся через EXPECT().

func TestService_Echo(t *testing.T) {
	env := ditest.InitTestEnv(t)

	env.Repo.EXPECT().AddEcho(mock.Anything, "world").Return(nil)

	got, err := env.Service.Echo(context.Background(), "world")
	require.NoError(t, err)
	assert.Equal(t, "Hello, world!", got)
}

func TestService_Stats(t *testing.T) {
	env := ditest.InitTestEnv(t)

	env.Repo.EXPECT().EchoCount(mock.Anything).Return(int64(42), nil)

	got, err := env.Service.Stats(context.Background())
	require.NoError(t, err)
	assert.Equal(t, int64(42), got)
}
